{
  "manifest_version": 3,
  "name": "HLS Stream Link Detector",
  "version": "1.0.0",
  "description": "Detect HLS streams, unwrap PNG media through a local proxy, and copy a playable m3u8 URL.",
  "permissions": ["webRequest", "storage", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Detected HLS streams", "default_popup": "popup.html" }
}
